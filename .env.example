# --- EU Compliance Pipeline configuration -----------------------------------
# Copy to ".env" and fill in for live (non-mock) runs on GCP.
# Leave PIPELINE_MOCK_MODE=1 (or unset GCP_PROJECT_ID) to run fully locally.

# Vertex AI / Gemini
GCP_PROJECT_ID=
GCP_LOCATION=europe-west4
GEMINI_MODEL=gemini-3.1-pro

# Document AI (ingestion)
DOCAI_LOCATION=eu
DOCAI_PROCESSOR_ID=
DOCAI_PROCESSOR_VERSION=

# BigQuery (reporting)
BQ_DATASET=eu_compliance
BQ_TABLE=eu_compliance_audits
BQ_LOCATION=EU

# Resilience
PIPELINE_MAX_RETRIES=5
PIPELINE_BASE_BACKOFF=1.0

# Local development: "1" forces deterministic in-memory fakes (no GCP needed).
# Defaults to enabled whenever GCP_PROJECT_ID is empty.
PIPELINE_MOCK_MODE=1
